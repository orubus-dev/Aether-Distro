# AetherOS x86_64 kernel configuration fragment
# Merged onto upstream x86_64_defconfig:
#   scripts/kconfig/merge_config.sh -m .config 02-kernel/aether-x86_64.config && make olddefconfig
# Supersedes the 17-line boot baseline; this is the full production laptop/gaming config.
# Build: build/kernel/build.sh — CI compiles from kernel.org source; no distro kernel ships in the ISO.

# ---- identity -----------------------------------------------------------------
CONFIG_LOCALVERSION="-aether"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="aetheros"

# ---- gaming scheduler / preemption --------------------------------------------
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHEDSTATS=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_INTEL_IDLE=y
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m

# ---- Android runtime support (Waydroid binder) ---------------------------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# ---- memory: zram swap for 8GB laptops -----------------------------------------
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC=y

# ---- filesystems ----------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FUSE_FS=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=m
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFIVAR_FS=y
CONFIG_SQUASHFS=m
# live media plumbing: squashfs in the ISO is zstd-compressed (auto/config) and
# live-boot mounts the root via overlay — both must exist or the live boot dies.
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# ---- graphics --------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FIRMWARE_EDID=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_FB=y

# ---- audio ------------------------------------------------------------------------
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_SOC=y
CONFIG_SND_PCI=y
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF=m
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y

# ---- wireless / wired / bluetooth --------------------------------------------------
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLDVM=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_MT7921E=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8851BE=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_BRCMFMAC=m
CONFIG_R8169=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_INTEL=m
CONFIG_BT_BCM=m
CONFIG_BT_RTL=m

# ---- input / touchpads / HID --------------------------------------------------------
CONFIG_I2C=y
CONFIG_I2C_HID_ACPI=m
CONFIG_I2C_HID_OF=m
CONFIG_HID_APPLE=m
CONFIG_HID_MICROSOFT=m
CONFIG_MOUSE_PS2_SYNAPTICS_SMBUS=y
CONFIG_RMI4_CORE=m
CONFIG_RMI4_SMB=m

# ---- storage --------------------------------------------------------------------------
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_POWER_SUPPLY=y
CONFIG_EXTCON=y
CONFIG_CHARGER_BQ24190=m
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=m
CONFIG_USB_UAS=y
CONFIG_USB_STORAGE=y

# ---- platform / power / thermal --------------------------------------------------------
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INT340X_THERMAL=m
CONFIG_INT3406_THERMAL=m
CONFIG_INTEL_SOC_DTS_IOSF_CORE=m
CONFIG_THINKPAD_ACPI=m
CONFIG_SURFACE_PLATFORMS=y
CONFIG_BATTERY_UG3105=m

# ---- virtualization (test rig + future VM guests) ---------------------------------------
CONFIG_KVM=y
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_9P_FS=m
CONFIG_NET_9P_VIRTIO=m

# ---- misc -------------------------------------------------------------------------------
CONFIG_SECURITY_APPARMOR=y
CONFIG_MODULE_SIG=n
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_STRIP_ASM_SYMS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_WERROR=n
CONFIG_GPIOLIB=y
