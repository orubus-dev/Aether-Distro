#!/bin/sh
set -e
# size discipline
apt-get purge -y gcc libc6-dev linux-libc-dev 2>/dev/null || true
apt-get remove -y plasma-workspace-wallpapers 2>/dev/null || true
apt-get autoremove -y --purge >/dev/null 2>&1 || true
apt-get clean
# size discipline: docs/manpages/locales are dead weight on a live image
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* /usr/share/man/??
find /usr/share/locale -mindepth 1 -maxdepth 1 -type d ! -name 'en_US' ! -name 'en' -exec rm -rf {} + 2>/dev/null || true
rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
truncate -s 0 /var/log/*/* 2>/dev/null || true
# clone-safe machine identity
rm -f /etc/machine-id /var/lib/dbus/machine-id
touch /etc/machine-id
