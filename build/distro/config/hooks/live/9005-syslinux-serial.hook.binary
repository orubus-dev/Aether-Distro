#!/bin/sh
set -e
# binary_hooks runs with CWD=binary/ (live-build does `cd binary; ../hook`),
# AFTER binary_syslinux generated the configs and BEFORE binary_iso (xorriso),
# so relative paths land inside the tree xorriso is about to pack.
# Rounds 9-10 bug: this hook used binary/isolinux/... paths — from CWD=binary/
# that resolved to binary/binary/... which never exists => nothing was patched
# => the menu stayed VGA-only with the template's `timeout 0` (wait forever),
# which is 25 min of serial silence in the headless CI boot, and no auto-boot
# for real users either.
# Fix: patch relative to CWD=binary/ — serial menu (VGA stays on too) + 5s boot.
for f in isolinux/*.cfg; do
  [ -f "$f" ] || continue
  grep -q "^serial " "$f" || sed -i '1i serial 0 115200' "$f"
  # template default is `timeout 0` (= wait forever at the menu); force 5s auto-boot
  sed -i 's/^timeout 0$/timeout 50/' "$f"
done
exit 0
